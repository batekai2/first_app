<h1>ログイン</h1>

<%= form_with url: login_path, method: :post do %>
  <div>
    <%= label_tag :email, "メールアドレス" %>
    <%= email_field_tag :email, params[:email], required: true, autocomplete: "username" %>
  </div>
  <div>
    <%= label_tag :password, "パスワード" %>
    <%= password_field_tag :password, nil, required: true, autocomplete: "current-password", minlength: 12 %>
  </div>
  <%= submit_tag "ログインする" %>
<% end %>
