<h1>新規投稿ページ</h1>

<% if @post.errors.any? %>
  <div class="error-messages" role="alert">
    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @post, url: posts_path do |form| %>
  <%= form.label :content, "内容" %>
  <%= form.text_area :content, maxlength: 1000, required: true, rows: 4 %>
  <%= form.submit "投稿する" %>
<% end %>

<%= link_to "トップページに戻る", posts_path %>
