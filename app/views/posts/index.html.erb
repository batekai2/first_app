<h1>トップページ</h1>

<% if logged_in? %>
  <%= link_to "新規投稿", new_post_path %>
<% else %>
  <p>投稿するには<%= link_to "ログイン", login_path %>してください。</p>
<% end %>

<% @posts.each do |post| %>
  <article class="post">
    <div class="post-date">
      投稿日時: <%= l(post.created_at, format: :long) rescue post.created_at %>
    </div>
    <div class="post-content">
      <%= post.content %>
    </div>
  </article>
<% end %>
